[Unit]
Description=L2Trader Market Data Recorder
Documentation=https://github.com/simonbeaudoin0935/L2Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=l2trader
Group=l2trader
WorkingDirectory=/var/lib/l2trader
Environment=LD_LIBRARY_PATH=/home/simon/Qt/6.8.3/gcc_64/lib:$LD_LIBRARY_PATH
ExecStart=/usr/bin/l2trader-recorder --stock-csv=/usr/share/doc/l2trader/examples/nasdaq_screener.csv
ExecStopPost=/usr/lib/l2trader/recorder-post-stop.sh
Restart=no
StandardOutput=journal
StandardError=journal
SyslogIdentifier=l2trader-recorder

# Security hardening
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/l2trader /var/log/l2trader
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

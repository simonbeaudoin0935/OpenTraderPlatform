#!/bin/sh
set -e

# Create l2trader user and group if they don't exist
if ! getent group l2trader >/dev/null; then
    addgroup --system l2trader
fi

if ! getent passwd l2trader >/dev/null; then
    adduser --system --ingroup l2trader --home /var/lib/l2trader \
            --no-create-home --disabled-password --shell /usr/sbin/nologin \
            --gecos "L2Trader Recorder Service" l2trader
fi

# Set ownership of data directories
chown l2trader:l2trader /var/lib/l2trader
chown l2trader:l2trader /var/log/l2trader

#DEBHELPER#

exit 0

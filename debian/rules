#!/usr/bin/make -f

# Enable hardening
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Use Ninja for faster builds
export DEB_BUILD_OPTIONS = parallel=$(shell nproc)

# Get the host architecture for cross-compilation support
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)

%:
	dh $@

override_dh_auto_configure:
	# Configure with CMake using Ninja for faster parallel builds
	# FETCHCONTENT_FULLY_DISCONNECTED=OFF overrides the Debian default (ON) so that
	# Databento can download its bundled dependencies (nlohmann_json, httplib, date)
	# which do not have suitable system packages on Ubuntu Noble.
	dh_auto_configure -- -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib/$(DEB_HOST_MULTIARCH) -DENABLE_GUI=ON -DBUILD_TESTS=OFF -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache -DFETCHCONTENT_FULLY_DISCONNECTED=OFF

override_dh_auto_build:
	# Build with Ninja using all available cores
	cmake --build obj-$(DEB_HOST_GNU_TYPE) --parallel $(shell nproc)

override_dh_auto_test:
	# Skip running tests during package build
	# Tests will be run in separate CI jobs after package installation
	@echo "Skipping tests during package build"

override_dh_auto_install:
	# Install main application binary
	install -D -m 0755 obj-$(DEB_HOST_GNU_TYPE)/Src/L2Trader debian/l2trader/usr/bin/l2trader
	install -D -m 0755 obj-$(DEB_HOST_GNU_TYPE)/bin/l2trader-mcp-server debian/l2trader/usr/bin/l2trader-mcp-server

	# Install out-of-process strategy SDK runtime and development files
	DESTDIR=$(CURDIR)/debian/l2trader-strategy-sdk cmake --install obj-$(DEB_HOST_GNU_TYPE) --component strategy-sdk-runtime
	DESTDIR=$(CURDIR)/debian/l2trader-strategy-sdk-dev cmake --install obj-$(DEB_HOST_GNU_TYPE) --component strategy-sdk-dev
	
	# Install bundled external strategy executables
	install -d debian/l2trader/usr/share/l2trader/strategies
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/bin/ExampleStrategyProcess debian/l2trader/usr/share/l2trader/strategies/
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/bin/CrashTestStrategyProcess debian/l2trader/usr/share/l2trader/strategies/
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/bin/HistoricalBarsStrategyProcess debian/l2trader/usr/share/l2trader/strategies/
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/bin/OrderTestStrategyProcess debian/l2trader/usr/share/l2trader/strategies/
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/bin/DumpPatternStrategyProcess debian/l2trader/usr/share/l2trader/strategies/

	# Install application icon
	install -D -m 0644 Resources/Icons/L2T.png debian/l2trader/usr/share/pixmaps/l2trader.png
	
	# Install desktop file
	install -D -m 0644 debian/l2trader.desktop debian/l2trader/usr/share/applications/l2trader.desktop
	
	# Install example configuration files
	install -d debian/l2trader/usr/share/doc/l2trader/examples
	install -m 0644 Example_Config/nasdaq_screener.csv debian/l2trader/usr/share/doc/l2trader/examples/
	install -m 0644 Example_Config/nasdaq_screener_mini.csv debian/l2trader/usr/share/doc/l2trader/examples/

override_dh_auto_clean:
	dh_auto_clean

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

#!/usr/bin/make -f

# Enable hardening
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	# Configure with CMake
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DENABLE_GUI=ON -DBUILD_TESTS=ON

override_dh_auto_build:
	# Build with CMake
	dh_auto_build

override_dh_auto_test:
	# Skip running tests during package build
	# Tests will be run in separate CI jobs after package installation
	@echo "Skipping tests during package build"

override_dh_auto_install:
	# Install main application binary
	install -D -m 0755 obj-x86_64-linux-gnu/src/L2Trader debian/l2trader/usr/bin/l2trader
	
	# Install recorder application binary
	install -D -m 0755 obj-x86_64-linux-gnu/src/Recorder debian/l2trader/usr/bin/l2trader-recorder
	
	# Install application icon
	install -D -m 0644 Resources/Icons/L2T.png debian/l2trader/usr/share/pixmaps/l2trader.png
	
	# Install desktop file
	install -D -m 0644 debian/l2trader.desktop debian/l2trader/usr/share/applications/l2trader.desktop
	
	# Install systemd service and timer files for recorder
	install -D -m 0644 debian/l2trader-recorder.service debian/l2trader/lib/systemd/system/l2trader-recorder.service
	install -D -m 0644 debian/l2trader-recorder-start.service debian/l2trader/lib/systemd/system/l2trader-recorder-start.service
	install -D -m 0644 debian/l2trader-recorder-start.timer debian/l2trader/lib/systemd/system/l2trader-recorder-start.timer
	install -D -m 0644 debian/l2trader-recorder-stop.service debian/l2trader/lib/systemd/system/l2trader-recorder-stop.service
	install -D -m 0644 debian/l2trader-recorder-stop.timer debian/l2trader/lib/systemd/system/l2trader-recorder-stop.timer
	
	# Install post-stop script
	install -D -m 0755 debian/recorder-post-stop.sh debian/l2trader/usr/lib/l2trader/recorder-post-stop.sh
	
	# Create directories for recorder runtime data
	install -d debian/l2trader/var/lib/l2trader
	install -d debian/l2trader/var/log/l2trader
	
	# Install example configuration files
	install -d debian/l2trader/usr/share/doc/l2trader/examples
	install -m 0644 Example_Config/*.ini debian/l2trader/usr/share/doc/l2trader/examples/ || true
	install -m 0644 Example_Config/*.csv debian/l2trader/usr/share/doc/l2trader/examples/ || true
	
	# Install tests binaries
	install -d debian/l2trader-tests/usr/lib/l2trader/tests
	install -D -m 0755 obj-x86_64-linux-gnu/Tests/test_barcache debian/l2trader-tests/usr/lib/l2trader/tests/test_barcache
	install -D -m 0755 obj-x86_64-linux-gnu/Tests/test_RunUpDetector debian/l2trader-tests/usr/lib/l2trader/tests/test_runupdetector
	install -D -m 0755 obj-x86_64-linux-gnu/Tests/test_tradestationclient debian/l2trader-tests/usr/lib/l2trader/tests/test_tradestationclient
	# FMPClient test is disabled as per build.yml
	# install -D -m 0755 obj-x86_64-linux-gnu/Tests/test_fmpclient debian/l2trader-tests/usr/lib/l2trader/tests/test_fmpclient

override_dh_auto_clean:
	dh_auto_clean

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

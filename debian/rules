#!/usr/bin/make -f

# Enable hardening
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Get the host architecture for cross-compilation support
DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)
DEB_HOST_GNU_TYPE ?= $(shell dpkg-architecture -qDEB_HOST_GNU_TYPE)

%:
	dh $@

override_dh_auto_configure:
	# Configure with CMake
	dh_auto_configure -- -DCMAKE_BUILD_TYPE=Release -DENABLE_GUI=ON -DBUILD_TESTS=OFF -DCMAKE_C_COMPILER_LAUNCHER=ccache -DCMAKE_CXX_COMPILER_LAUNCHER=ccache

override_dh_auto_build:
	# Build with CMake
	dh_auto_build

override_dh_auto_test:
	# Skip running tests during package build
	# Tests will be run in separate CI jobs after package installation
	@echo "Skipping tests during package build"

override_dh_auto_install:
	# Install main application binary
	install -D -m 0755 obj-$(DEB_HOST_GNU_TYPE)/Src/L2Trader debian/l2trader/usr/bin/l2trader
	
	# Install strategy SDK library
	install -D -m 0755 obj-$(DEB_HOST_GNU_TYPE)/Src/libL2TraderStrategy.so debian/l2trader/usr/lib/libL2TraderStrategy.so
	
	# Install strategy plugins
	install -d debian/l2trader/usr/share/l2trader/strategies
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/lib/ExampleStrategy.so debian/l2trader/usr/share/l2trader/strategies/
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/lib/CrashTestStrategy.so debian/l2trader/usr/share/l2trader/strategies/
	install -m 0755 obj-$(DEB_HOST_GNU_TYPE)/lib/HistoricalBarsStrategy.so debian/l2trader/usr/share/l2trader/strategies/
	
	# Install strategy configuration files
	install -m 0644 Strategies/ExampleStrategy/example_strategy.json debian/l2trader/usr/share/l2trader/strategies/
	install -m 0644 Strategies/CrashTestStrategy/crash_test_strategy.json debian/l2trader/usr/share/l2trader/strategies/
	
	# Install application icon
	install -D -m 0644 Resources/Icons/L2T.png debian/l2trader/usr/share/pixmaps/l2trader.png
	
	# Install desktop file
	install -D -m 0644 debian/l2trader.desktop debian/l2trader/usr/share/applications/l2trader.desktop
	
	# Install example configuration files
	install -d debian/l2trader/usr/share/doc/l2trader/examples
	install -m 0644 Example_Config/nasdaq_screener.csv debian/l2trader/usr/share/doc/l2trader/examples/
	install -m 0644 Example_Config/nasdaq_screener_mini.csv debian/l2trader/usr/share/doc/l2trader/examples/

override_dh_auto_clean:
	dh_auto_clean

override_dh_shlibdeps:
	dh_shlibdeps --dpkg-shlibdeps-params=--ignore-missing-info

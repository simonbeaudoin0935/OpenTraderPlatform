{
    "version": "2.0.0",
    "tasks": [

        {
            "label": "clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            }
        },



        {
            "label": "configure-main-only",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/L2Trader",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DENABLE_GUI=ON",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_RECORDER=OFF"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "configure-recorder-only",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/L2Trader_Recorder",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DENABLE_GUI=OFF",
                "-DBUILD_TESTS=OFF",
                "-DBUILD_RECORDER=ON"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "configure-all",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build/All",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DENABLE_GUI=ON",
                "-DBUILD_TESTS=ON",
                "-DBUILD_RECORDER=ON"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        }, 

    
        {
            "label": "build-main-only",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/L2Trader",
                "--parallel",
                "3"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "dependsOn": ["configure-main-only"]
        },
        {
            "label": "build-recorder-only",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/L2Trader_Recorder",
                "--parallel",
                "3"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "dependsOn": ["configure-recorder-only"]
        },
        {
            "label": "build-all",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/All",
                "--parallel",
                "3"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "dependsOn": ["configure-all"]
        },



        {
            "label": "run-main",
            "type": "shell",
            "command": "${workspaceFolder}/build/L2Trader/src/L2Trader",
            "args": [
                "--criterias=${workspaceFolder}/Example_Config/selection_criteria.ini"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build-main-only"]
        },
        {
            "label": "run-recorder",
            "type": "shell",
            "command": "${workspaceFolder}/build/L2Trader_Recorder/src/L2Trader_Recorder",
            "args": [
                "--criterias=${workspaceFolder}/Example_Config/selection_criteria.ini",
                "--stock-csv=${workspaceFolder}/Example_Config/nasdaq_screener_mini.csv"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build-recorder-only"]
        },


       {
            "label": "run-barcache-test",
            "type": "shell",
            "command": "${workspaceFolder}/build/All/Tests/test_barcache",
            "args": [
                "--cache-root-dir=/tmp/l2trader_test_cache",
                "--stock-csv=${workspaceFolder}/Example_Config/nasdaq_screener.csv"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build"]
        },
        {
            "label": "run-fmpclient-test",
            "type": "shell",
            "command": "${workspaceFolder}/build/Tests/test_fmpclient",
            "args": [
                "--stock-csv=${workspaceFolder}/Example_Config/nasdaq_screener.csv"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build"]
        },
        {
            "label": "run-tsclient-test",
            "type": "shell",
            "command": "${workspaceFolder}/build/Tests/test_tradestationclient",
            "args": [
                "--stock-csv=${workspaceFolder}/Example_Config/nasdaq_screener.csv"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build"]
        },
        {
            "label": "run-runupdetector-test",
            "type": "shell",
            "command": "${workspaceFolder}/build/Tests/test_RunUpDetector",
            "args": [
                "--stock-csv=${workspaceFolder}/Example_Config/nasdaq_screener.csv"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build"]
        }
    ]
}
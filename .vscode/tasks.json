        {
            "label": "run-tui",
            "type": "shell",
            "command": "${workspaceFolder}/build/TUI/Src/L2Trader 2>/dev/null",
            "args": [],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": [

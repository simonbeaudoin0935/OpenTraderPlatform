{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "qmake",
            "type": "shell",
            "command": "/home/simon/Qt/6.8.3/gcc_64/bin/qmake",
            "args": [
                "${workspaceFolder}/TradingAlgorithm.pro",
                "-o",
                "${workspaceFolder}/build/Makefile",
                "-spec",
                "linux-g++",
                "CONFIG+=debug",
                "CONFIG+=qml_debug"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "make",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            },
            "problemMatcher": "$gcc",
            "dependsOn": ["qmake"]
        },
        {
            "label": "build",
            "dependsOn": ["make"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "clean",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}/build"
            },
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared"
            }
        },
        {
            "label": "run",
            "type": "shell",
            "command": "${workspaceFolder}/build/src/L2Trader",
            "args": [
                "--criterias=${workspaceFolder}/Example_Config/selection_criteria.ini"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "shared"
            },
            "dependsOn": ["build"]
        }
    ]
}
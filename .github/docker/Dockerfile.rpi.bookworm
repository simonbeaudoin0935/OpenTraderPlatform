
# This dockerfile is built by an amd64 machine (ubuntu-latest GitHub runner) FOR an amd64 machine,
# which will contain the cross-compilation toolchain and dependencies to build Debian packages for
# Raspberry Pi 4 running Debian Bookworm (aarch64/arm64).

# Use Debian Bookworm as base image for amd64 architecture
FROM debian:bookworm

# Prevent interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Add ARM64 architecture for cross-compilation
RUN dpkg --add-architecture arm64

# Update package list and install cross-compilation tools and dependencies
RUN apt-get update && apt-get install -y \
    git \
    tree \
    cmake \
    make \
    build-essential \
    debhelper-compat \
    crossbuild-essential-arm64 \
    qt6-base-dev:arm64 \
    qt6-base-private-dev:arm64 \
    qt6-charts-dev:arm64 \
    qt6-webengine-dev:arm64 \
    libqt6sql6-sqlite:arm64 \
    qtkeychain-qt6-dev:arm64 \
    libsecret-1-dev:arm64 \
    ccache \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Set up environment for cross-compilation
ENV PKG_CONFIG_PATH=/usr/lib/aarch64-linux-gnu/pkgconfig

# Set working directory
WORKDIR /workspace

# Default command
CMD [ "bash" ]

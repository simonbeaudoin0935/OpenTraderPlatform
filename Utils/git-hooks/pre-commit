#!/bin/bash
#
# Pre-commit hook that runs clang-format on staged C++ files
# Ensures code formatting and checks for trailing whitespace
#

# Exit on any error
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if clang-format is installed
if ! command -v clang-format &> /dev/null; then
    echo -e "${RED}Error: clang-format is not installed.${NC}"
    echo "Please install clang-format: sudo apt-get install clang-format"
    echo "Or on macOS: brew install clang-format"
    exit 1
fi

# Get the root directory of the git repository
REPO_ROOT=$(git rev-parse --show-toplevel)
CLANG_FORMAT_CONFIG="${REPO_ROOT}/.clang-format"

# Check if clang-format config exists
if [ ! -f "$CLANG_FORMAT_CONFIG" ]; then
    echo -e "${RED}Error: clang-format config file not found at $CLANG_FORMAT_CONFIG${NC}"
    exit 1
fi

# Get list of staged C++ files (including .h, .hpp, .cpp, .cc, .cxx)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|h|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    # No C++ files staged, nothing to check
    exit 0
fi

echo -e "${YELLOW}Running clang-format on staged C++ files...${NC}"

FORMATTING_ISSUES=0
TRAILING_WHITESPACE_ISSUES=0

# Create a temporary directory for formatted files
TMP_DIR=$(mktemp -d)
trap "rm -rf $TMP_DIR" EXIT

for FILE in $STAGED_FILES; do
    # Skip files that don't exist (might be deleted)
    if [ ! -f "$FILE" ]; then
        continue
    fi

    # Format the file and compare
    FORMATTED_FILE="$TMP_DIR/$(basename "$FILE")"
    clang-format "$FILE" > "$FORMATTED_FILE"

    if ! diff -q "$FILE" "$FORMATTED_FILE" > /dev/null; then
        echo -e "${RED}Formatting issue in $FILE${NC}"
        FORMATTING_ISSUES=$((FORMATTING_ISSUES + 1))

        # Show diff
        echo "Differences:"
        diff -u "$FILE" "$FORMATTED_FILE" | head -20
        echo ""
    fi

    # Check for trailing whitespace
    if grep -q '[[:space:]]$' "$FILE"; then
        echo -e "${RED}Trailing whitespace found in $FILE${NC}"
        TRAILING_WHITESPACE_ISSUES=$((TRAILING_WHITESPACE_ISSUES + 1))
    fi
done

# Check YAML files for trailing whitespace
STAGED_YAML_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(yml|yaml)$' || true)

YAML_WHITESPACE_ISSUES=0

for FILE in $STAGED_YAML_FILES; do
    if grep -q '[[:space:]]$' "$FILE"; then
        echo -e "${RED}Trailing whitespace found in YAML file $FILE${NC}"
        YAML_WHITESPACE_ISSUES=$((YAML_WHITESPACE_ISSUES + 1))
    fi
done

if [ $YAML_WHITESPACE_ISSUES -gt 0 ]; then
    echo -e "${RED}Found $YAML_WHITESPACE_ISSUES YAML file(s) with trailing whitespace.${NC}"
    echo "Please remove trailing whitespace from YAML files and try again."
    exit 1
fi

# If there are formatting issues, offer to fix them
if [ $FORMATTING_ISSUES -gt 0 ]; then
    echo -e "${YELLOW}Found $FORMATTING_ISSUES file(s) with formatting issues.${NC}"
    echo "Run the following to fix:"
    echo "  find Src -name \"*.cpp\" -o -name \"*.h\" | xargs clang-format -i"
    echo ""
    echo -e "${RED}Commit aborted. Please fix formatting issues and try again.${NC}"
    exit 1
fi

# If there are trailing whitespace issues in C++ files, warn but don't block
if [ $TRAILING_WHITESPACE_ISSUES -gt 0 ]; then
    echo -e "${YELLOW}Warning: Found $TRAILING_WHITESPACE_ISSUES C++ file(s) with trailing whitespace.${NC}"
    echo "Removing trailing whitespace automatically..."
    
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ] && grep -q '[[:space:]]$' "$FILE"; then
            sed -i 's/[[:space:]]*$//' "$FILE"
            git add "$FILE"
        fi
    done
    
    echo -e "${GREEN}Trailing whitespace removed and files re-staged.${NC}"
fi

echo -e "${GREEN}All staged C++ files are properly formatted and YAML files have no trailing whitespace!${NC}"
exit 0

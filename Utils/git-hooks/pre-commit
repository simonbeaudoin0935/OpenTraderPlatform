#!/bin/bash
#
# Pre-commit hook that runs Uncrustify on staged C++ files
# Ensures code formatting and checks for trailing whitespace
#

# Exit on any error
set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Check if uncrustify is installed
if ! command -v uncrustify &> /dev/null; then
    echo -e "${RED}Error: uncrustify is not installed.${NC}"
    echo "Please install uncrustify: sudo apt-get install uncrustify"
    echo "Or on macOS: brew install uncrustify"
    exit 1
fi

# Get the root directory of the git repository
REPO_ROOT=$(git rev-parse --show-toplevel)
UNCRUSTIFY_CONFIG="${REPO_ROOT}/.uncrustify.cfg"

# Check if uncrustify config exists
if [ ! -f "$UNCRUSTIFY_CONFIG" ]; then
    echo -e "${RED}Error: Uncrustify config file not found at $UNCRUSTIFY_CONFIG${NC}"
    exit 1
fi

# Get list of staged C++ files (including .h, .hpp, .cpp, .cc, .cxx)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|h|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    # No C++ files staged, nothing to check
    exit 0
fi

echo -e "${YELLOW}Running Uncrustify on staged C++ files...${NC}"

FORMATTING_ISSUES=0
TRAILING_WHITESPACE_ISSUES=0

# Create a temporary directory for formatted files
TMP_DIR=$(mktemp -d)
trap "rm -rf $TMP_DIR" EXIT

# Check each staged file
for FILE in $STAGED_FILES; do
    # Skip deleted files
    if [ ! -f "$FILE" ]; then
        continue
    fi
    
    echo "Checking $FILE..."
    
    # Check for trailing whitespace
    if grep -n '[[:space:]]$' "$FILE" > /dev/null; then
        echo -e "${RED}  ✗ Trailing whitespace found${NC}"
        grep -n '[[:space:]]$' "$FILE" | head -5 | while read -r line; do
            echo -e "${YELLOW}    Line: $line${NC}"
        done
        TRAILING_WHITESPACE_ISSUES=$((TRAILING_WHITESPACE_ISSUES + 1))
    fi
    
    # Run uncrustify to check formatting
    TMP_FILE="${TMP_DIR}/$(basename $FILE)"
    if ! uncrustify -c "$UNCRUSTIFY_CONFIG" -f "$FILE" -o "$TMP_FILE" --no-backup -q; then
        echo -e "${RED}  ✗ Uncrustify failed${NC}"
        FORMATTING_ISSUES=$((FORMATTING_ISSUES + 1))
        continue
    fi
    
    # Compare the original and formatted files
    if ! diff -q "$FILE" "$TMP_FILE" > /dev/null; then
        echo -e "${RED}  ✗ File needs formatting${NC}"
        FORMATTING_ISSUES=$((FORMATTING_ISSUES + 1))
        
        # Show a preview of the changes (first 10 lines of diff)
        echo -e "${YELLOW}    Preview of required changes:${NC}"
        diff -u "$FILE" "$TMP_FILE" | awk 'NR>=3 && NR<=15 {print "    " $0}' | while read -r line; do
            echo -e "${YELLOW}$line${NC}"
        done
    else
        echo -e "${GREEN}  ✓ Formatting OK${NC}"
    fi
done

# Report results
echo ""
if [ $FORMATTING_ISSUES -gt 0 ] || [ $TRAILING_WHITESPACE_ISSUES -gt 0 ]; then
    echo -e "${RED}╔════════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${RED}║  Commit aborted: Code formatting issues detected              ║${NC}"
    echo -e "${RED}╚════════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    
    if [ $FORMATTING_ISSUES -gt 0 ]; then
        echo -e "${YELLOW}Files with formatting issues: $FORMATTING_ISSUES${NC}"
        echo "To fix formatting, run:"
        echo ""
        echo "  uncrustify -c .uncrustify.cfg --no-backup --replace <file>"
        echo ""
        echo "Or to format all staged files automatically:"
        echo ""
        echo "  git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|cc|cxx|h|hpp)$' | xargs -r uncrustify -c .uncrustify.cfg --no-backup --replace"
        echo ""
    fi
    
    if [ $TRAILING_WHITESPACE_ISSUES -gt 0 ]; then
        echo -e "${YELLOW}Files with trailing whitespace: $TRAILING_WHITESPACE_ISSUES${NC}"
        echo "To remove trailing whitespace, run:"
        echo ""
        echo "  sed -i 's/[[:space:]]*$//' <file>"
        echo ""
    fi
    
    echo "After fixing issues, stage your changes again with 'git add' and retry the commit."
    exit 1
fi

echo -e "${GREEN}╔════════════════════════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  All checks passed! Proceeding with commit...                 ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════════════════════════════╝${NC}"

exit 0
